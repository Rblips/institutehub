# ==============================================================================
# InstituteHub Logrotate Configuration for Nginx Access/Error Logs
# Destination: /etc/logrotate.d/institutehub
# ==============================================================================

/var/log/nginx/institutehub_access.log
/var/log/nginx/institutehub_error.log {
    daily
    missingok
    rotate 30
    compress
    delaycompress
    notifempty
    create 0640 www-data adm
    sharedscripts
    prerotate
        if [ -d /etc/logrotate.d/httpd-prerotate ]; then \
            run-parts /etc/logrotate.d/httpd-prerotate; \
        fi \
    endscript
    postrotate
        invoke-rc.d nginx rotate >/dev/null 2>&1 || true
    endscript
}
