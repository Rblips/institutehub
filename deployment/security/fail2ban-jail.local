# ==============================================================================
# InstituteHub Fail2ban Jail Configuration
# Destination: /etc/fail2ban/jail.d/institutehub.local
# ==============================================================================

[DEFAULT]
bantime  = 1h
findtime = 10m
maxretry = 5
banaction = ufw
ignoreip = 127.0.0.1/8 ::1 10.0.0.0/8 192.168.0.0/16

# ------------------------------------------------------------------------------
# SSH Brute Force Jail
# ------------------------------------------------------------------------------
[sshd]
enabled  = true
port     = 22
logpath  = /var/log/auth.log
backend  = systemd
maxretry = 3
bantime  = 24h

# ------------------------------------------------------------------------------
# Nginx Rate Limiting / 4xx Flood Jail
# ------------------------------------------------------------------------------
[nginx-limit-req]
enabled  = true
port     = http,https
logpath  = /var/log/nginx/institutehub_error.log
maxretry = 10
findtime = 2m
bantime  = 2h

# ------------------------------------------------------------------------------
# Nginx Malicious Script / Vulnerability Scanner Jail
# ------------------------------------------------------------------------------
[nginx-noscript]
enabled  = true
port     = http,https
logpath  = /var/log/nginx/institutehub_error.log
maxretry = 2
bantime  = 72h

# ------------------------------------------------------------------------------
# Nginx Bad User-Agents & Crawlers
# ------------------------------------------------------------------------------
[nginx-badbots]
enabled  = true
port     = http,https
logpath  = /var/log/nginx/institutehub_access.log
maxretry = 2
bantime  = 48h
